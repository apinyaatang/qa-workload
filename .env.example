# ═══════════════════════════════════════════════════════════════════════════
#  ⚠️  ตัวแปรที่ขึ้นต้นด้วย VITE_ ถูกฝังลงใน JavaScript bundle ตอน build
#      ทุกคนที่เปิดเว็บดาวน์โหลดค่าพวกนี้ไปได้ทั้งหมด — ไม่ใช่ความลับ
#
#      ห้ามใส่ค่าเหล่านี้ในตัวแปร VITE_ เด็ดขาด:
#        • SUPABASE_SERVICE_ROLE_KEY
#          ← เท่ากับยกสิทธิ์เจ้าของ database ให้ทุกคนที่เปิดเว็บ และข้าม RLS ได้ทั้งหมด
#            อันนี้ไม่มีเวอร์ชัน "รั่วแต่ยังใช้งานได้" ให้เลือก
#            ต้องอยู่ใน Supabase Edge Function เท่านั้น (runtime ใส่ให้อัตโนมัติ)
#
#      secret ที่ต้องเป็นความลับจริงต้องอยู่ฝั่ง server
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────────────────
# anon key ถูกออกแบบให้เปิดเผยได้ — สิ่งที่กั้นจริงคือ RLS policy ไม่ใช่ตัว key
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── บังคับล็อกอิน ──────────────────────────────────────────────────────────
# false = ข้ามระบบ auth ทั้งหมด ทุกคนได้สิทธิ์ admin (พฤติกรรมเดิมก่อนมี login)
# true  = บังคับล็อกอินและแยกสิทธิ์ตาม role
#
# ⛔ ห้ามตั้งเป็น true ก่อนรัน supabase/migrations/02_authenticated_policies.sql
#    policy ที่มีอยู่ผูกกับ role `anon` แต่คนที่ล็อกอินแล้วรันเป็น `authenticated`
#    วินาทีที่คนแรกล็อกอินสำเร็จ ทุก SELECT จะคืน [] แบบเงียบๆ และการเขียนล้มทั้งหมด
#    แอปจะดูเหมือนติดตั้งใหม่ที่ยังไม่มีข้อมูล ทั้งที่ข้อมูลยังอยู่ครบ
#
# ลำดับการเปิดที่ปลอดภัย: docs/AUTH_ROLLOUT.md
VITE_REQUIRE_AUTH=false


# ═══════════════════════════════════════════════════════════════════════════
#  Phase 6 — secret ที่รั่วอยู่ในวันนี้
# ═══════════════════════════════════════════════════════════════════════════
#  ตอนนี้เหตุผล "ใครมี URL ก็เห็นทุกอย่างอยู่แล้ว" ทำให้เรื่องนี้ดูเป็นเรื่องเล็ก
#  แต่หลัง Phase 5 (ปิด RLS) มันจะเป็น secret เดียวที่เหลืออยู่โดยไม่มีอะไรกั้น
#  และ ADO PAT ให้สิทธิ์เข้าถึงเกินขอบเขตของเครื่องมือนี้ไปไกล
#
#  ปล่อยสามตัวข้างล่างเป็น comment ไว้ — ระบบทำงานได้โดยไม่ต้องมี:
#    • Epic sync รับค่า ADO ผ่านหน้า Sync ในแอป (เก็บลง localStorage)
#    • AdoDashboard ซ่อนตัวเองเมื่อไม่มีค่า
#    • การแจ้งเตือน Teams ข้ามไปเมื่อไม่มี webhook
#
#  ถ้าใส่ค่าเข้าไป = ประกาศ PAT ให้ทุกคนที่เปิดเว็บ ให้รอ Edge Function proxy
#  ที่มาแทน (เริ่มที่ Teams webhook ก่อน เพราะไม่มีเรื่อง CORS เข้ามาเกี่ยว)
#
#  โค้ดที่อ่านค่าพวกนี้:
#    src/components/progress/AdoDashboard.tsx        (VITE_ADO_ORG_URL, VITE_ADO_PAT)
#    src/components/progress/UpdateProgressForm.tsx  (VITE_TEAMS_WEBHOOK_URL)
# ═══════════════════════════════════════════════════════════════════════════

# VITE_ADO_ORG_URL=
# VITE_ADO_PAT=
# VITE_TEAMS_WEBHOOK_URL=
